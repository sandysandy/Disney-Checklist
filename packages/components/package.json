{
  "name": "@govuk-mui/react",
  "version": "0.1.0",
  "description": "GOV.UK Design System components for React, built on Base UI primitives and styled from official govuk-frontend tokens",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./src/styles/index.scss",
    "./styles.css": "./dist/govuk-mui.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "tokens": "node scripts/generate-tokens.mjs",
    "build": "npm run tokens && vite build && tsc -p tsconfig.build.json && sass --load-path=../../node_modules --style=compressed src/styles/index.scss dist/govuk-mui.css",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "govuk-frontend": "^6.2.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.4.3",
    "@storybook/addon-docs": "^10.4.3",
    "@storybook/react-vite": "^10.4.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.10.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sass-embedded": "^1.85.0",
    "storybook": "^10.4.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
